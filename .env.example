# Spa 99 settings. Real values never go in git.
# Your Mac: put them in $SPA99_PRIVATE_DIR/Secrets/.env (OneDrive, Software Files/Secrets/.env).
# Live: the server's env file. Load order: real environment, Secrets/.env, project .env, dev defaults.
# The app logs a warning for every missing key below that is not marked (optional).

# ---------- core ----------

# Settings file: dev locally, config.settings.prod on live.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Long random key. Live refuses to start with a placeholder.
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
# (optional) Dev only; live always forces it off.
DEBUG=true
# (optional) Blank locally = SQLite at .private/db.sqlite3. Required on live: managed PostgreSQL,
# e.g. postgres://user:password@db-host:5432/spa99 (sslmode=require is added automatically).
DATABASE_URL=
# (optional) Private folder with Secrets/.env, db-backups/ and media/. Falls back to .private/ if missing.
SPA99_PRIVATE_DIR=

# ---------- addresses ----------

# Public site (no https://). Locally: localhost.
DOMAIN=spa99.uk
# Office (business dashboard, Gold approvals). Locally: office.localhost.
OFFICE_DOMAIN=office.spa99.uk
# Control (building controls, parked). Locally: control.localhost.
CONTROL_DOMAIN=control.spa99.uk
# System (developers only: business rules and audit log). Locally: system.localhost.
SYSTEM_DOMAIN=system.spa99.uk
# Lock code for System: digits only, 6-12; asked together with your password when unlocking System. Required on live (the site will not start without it).
SYSTEM_UNLOCK_CODE=
# Path of the hidden Django admin on the Control address. Required on live and must not be this example value.
ADMIN_PATH=backstage-7d3f9a/
# (optional) Full URLs for links in emails, no trailing slash. Default https://<domain> (dev http://<domain>:8000).
SITE_URL=
OFFICE_URL=
CONTROL_URL=
SYSTEM_URL=
# (optional) Extra allowed hosts, comma separated (the four domains, localhost and 127.0.0.1 are always allowed).
ALLOWED_HOSTS=
# (optional) Live only: header Caddy fills with the real visitor IP (see the Caddyfile).
CLIENT_IP_HEADER=X-Client-IP

# ---------- email ----------
# Who receives what (Gold approver, CC, contact address) is set in System > Emails, not here.

# The From address on every email. Required on live. DKIM/SPF are set up with the mail provider and DNS, not here.
DEFAULT_FROM_EMAIL=Spa 99 <hello@spa99.uk>
# (optional) From address for server error emails. Default: DEFAULT_FROM_EMAIL.
SERVER_EMAIL=
# (optional) Dev prints emails to the console. Live: the provider's backend (SMTP by default).
EMAIL_BACKEND=
# (optional) SMTP details, only with the SMTP backend. The password is a secret.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# (optional) Amazon SES region, only with notifications.backends.SesBackend.
AWS_SES_REGION_NAME=eu-west-2
# (optional) ARN of the SNS topic that carries SES bounce and complaint notifications (docs/features/email.md).
# Empty = POST /ses/notifications/ is off. Once set, only messages from this topic, signed by Amazon, are accepted.
SES_SNS_TOPIC_ARN=

# ---------- media (S3) ----------
# Empty bucket = files saved locally. The bucket is private; links are signed.

# (optional)
AWS_STORAGE_BUCKET_NAME=
# (optional)
AWS_S3_REGION_NAME=eu-west-2
# (optional) Your Mac only, limited to the dev/ folder. Never on the server (it uses its instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- errors (Sentry) ----------

# (optional) Off when empty. Sentry > project > Client Keys (DSN).
SENTRY_DSN=
# (optional) Default dev locally, live with the prod settings.
SENTRY_ENVIRONMENT=
# (optional) Release shown in Sentry; docker-compose sets it from APP_TAG.
APP_VERSION=
# (optional) Share of requests traced / profiled, 0 to 1. Default 0 (off).
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

# ---------- System ----------

# (optional) Badge System shows. Default DEV locally, LIVE with the prod settings.
SYSTEM_ENV_LABEL=
# (optional) Days to keep the audit log; empty or 0 = forever. Only prune_audit_log uses it.
SYSTEM_AUDIT_RETENTION_DAYS=

# ---------- Control (building) ----------

# (optional) Largest upload in the Control Library, in MB. Defaults: audio 50, video 500, image 20.
CONTROL_MAX_AUDIO_MB=50
CONTROL_MAX_VIDEO_MB=500
CONTROL_MAX_IMAGE_MB=20
# (optional) Hours a signed link to a Library file stays valid on live (screens and music loops refresh before then). Default 12.
CONTROL_MEDIA_URL_HOURS=12
# (optional) Total size of the whole Control Library in GB (default 10). Uploads are refused once it is full.
CONTROL_LIBRARY_MAX_GB=10

# ---------- site switches ----------

# (optional) false turns the 3D Gold Card off everywhere (visitors get the flat card).
SITE_WEBGL=true

# ---------- background jobs ----------

# (optional) Your Mac runs jobs straight away (emails print at once). Set 0 to test the real queue with `manage.py qcluster`.
Q_SYNC=1

# ---------- server (docker-compose and entrypoint only) ----------

# (optional) Image and tag to run (tag = the git tag, e.g. 1.2.3, never "latest").
IMAGE=registry.example.com/spa99
APP_TAG=0.0.0
# (optional) Gunicorn workers per container.
GUNICORN_WORKERS=3
# (optional) Seconds before gunicorn gives up on a request (big Control uploads need time). Default 300.
GUNICORN_TIMEOUT=300
