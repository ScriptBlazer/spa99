# Spa 99 configuration. Copy to .env and edit. Real secrets never go in git.
# Load order: real environment variables, then $SPA99_PRIVATE_DIR/env/.env, then project .env, then dev defaults.
# On start the app warns in the logs for every key below that is missing (keys marked optional are skipped).

# Which settings file to use. Keep dev locally; set config.settings.prod in the server .env.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Django secret key. Required in prod (the app refuses to start with a dev or placeholder value).
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string

# Public site domain (no https://). Used for allowed hosts, CSRF origins and the Caddyfile.
DOMAIN=spa99.uk

# Spa 99 Control domain. Locally this defaults to control.localhost.
CONTROL_DOMAIN=control.spa99.uk

# (optional, only docker-compose.yml reads these) Docker image to run and its tag (the git tag, e.g. 1.2.3). Never "latest".
IMAGE=registry.example.com/spa99
# (optional, docker-compose.yml only) The tag to run, same as the git tag.
APP_TAG=0.0.0

# (optional) Database URL. Blank locally = SQLite at .private/db.sqlite3. Required in prod: managed PostgreSQL,
# e.g. postgres://user:password@db-host.example.com:5432/spa99 (sslmode=require is added automatically).
DATABASE_URL=

# (optional) Debug mode. Dev only; prod always forces it off.
DEBUG=true

# (optional) Extra allowed hosts, comma separated. Added to the defaults (DOMAIN, CONTROL_DOMAIN, localhost, 127.0.0.1).
ALLOWED_HOSTS=

# (optional) Prod only: the request header Caddy fills with the real visitor IP (default X-Client-IP, see the Caddyfile,
# which works with or without Cloudflare in front).
CLIENT_IP_HEADER=X-Client-IP

# URL path of the hidden Django admin on the Control domain. Required in prod and must NOT be the default
# below (prod refuses to start otherwise). Pick something non-obvious. Locally the default is used if unset.
ADMIN_PATH=backstage-7d3f9a/

# (optional) Private folder holding env/.env, db-backups/ and media/. Falls back to .private/ if missing.
SPA99_PRIVATE_DIR=

# (optional) S3 media bucket. Leave empty to save files locally (never crashes). Bucket is private, signed URLs.
AWS_STORAGE_BUCKET_NAME=
# (optional) S3 region.
AWS_S3_REGION_NAME=eu-west-2
# (optional) Local dev only, limited to the dev/ folder. Never set on the server: it uses its instance role.
AWS_ACCESS_KEY_ID=
# (optional) Local dev only, see above.
AWS_SECRET_ACCESS_KEY=

# (optional) Email backend. Dev default prints emails to the console. Live: notifications.backends.SesBackend
# (Amazon SES through the server's IAM role, no keys here) or django.core.mail.backends.smtp.EmailBackend (default in prod).
EMAIL_BACKEND=
# (optional) SMTP settings, only used with the SMTP backend.
EMAIL_HOST=
# (optional) SMTP port (587 with TLS).
EMAIL_PORT=587
# (optional) SMTP username, only for the SMTP backend.
EMAIL_HOST_USER=
# (optional) SMTP password, only for the SMTP backend. A secret.
EMAIL_HOST_PASSWORD=
# (optional) Use TLS for SMTP.
EMAIL_USE_TLS=true
# (optional) The From address on every email. Replies go to the contact email in Site settings (hello@spa99.uk).
DEFAULT_FROM_EMAIL=Spa 99 <hello@spa99.uk>
# (optional) SES region for notifications.backends.SesBackend.
AWS_SES_REGION_NAME=eu-west-2
# (optional) Public site URL used in email links, no trailing slash. Default https://DOMAIN (dev http://localhost:8000).
SITE_URL=
# (optional) Spa 99 Control URL used in the Gold email "Open in Control" button. Default https://CONTROL_DOMAIN (dev http://control.localhost:8000).
CONTROL_URL=

# (optional) Sentry error reporting. Off when empty.
SENTRY_DSN=

# (optional) Number of gunicorn workers in the container.
GUNICORN_WORKERS=3
