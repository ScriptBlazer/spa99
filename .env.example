# Spa 99 settings. Real values NEVER go in git; this file only has placeholders like <this>.
#
# Live server: copy this file to `.env` next to docker-compose.yml and fill in the "REQUIRED ON LIVE" block.
#   Live refuses to start, listing every problem, if one of those is missing, a placeholder, or wrong.
#   Wrap SECRET_KEY in single quotes (it may contain $). Live always runs config.settings.prod (docker-compose forces it).
# Your Mac: values go in $SPA99_PRIVATE_DIR/Secrets/.env (OneDrive, Software Files/Secrets/.env).
# Load order, first wins: real environment, Secrets/.env, project .env, dev defaults.
# On start the app warns about every key below whose comment does not say "optional".
# common/tests/test_env_example.py checks that every variable the code reads is listed here.

# =====================================================================================================
# REQUIRED ON LIVE (the site will not start without these)
# =====================================================================================================

# Long random key, new for live (never reuse your Mac's). Generate:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY='<long-random-secret-key>'
# (optional locally: blank = SQLite at .private/db.sqlite3) Live: the RDS PostgreSQL, URL-encode symbols in the password.
# sslmode=require is added automatically.
DATABASE_URL=postgres://<user>:<password>@<rds-endpoint>:5432/spa99
# (optional locally: blank = files in the private folder) Live: the private S3 bucket for every upload.
AWS_STORAGE_BUCKET_NAME=<bucket-name>
# Lock code for System unlock: digits only, 6 to 12. A secret.
SYSTEM_UNLOCK_CODE=<6-to-12-digits>
# Path of the hidden Django admin (on the Control address). Your own value; live refuses the committed default.
ADMIN_PATH=<your-own-hidden-path>/
# The From address on every email. DKIM/Return-Path are set up in Postmark and Cloudflare DNS, not here.
DEFAULT_FROM_EMAIL=Spa 99 <hello@spa99.uk>
# Host names, bare (no https://). Locally: localhost, office.localhost, system.localhost, control.localhost.
DOMAIN=spa99.uk
OFFICE_DOMAIN=office.spa99.uk
SYSTEM_DOMAIN=system.spa99.uk
CONTROL_DOMAIN=control.spa99.uk

# =====================================================================================================
# EMAIL (Postmark SMTP on live)
# =====================================================================================================
# Who receives what (Gold approver, CC, contact address, staff alerts) is set in System, not here.

# (optional) Blank = Postmark SMTP on live, print to the console on your Mac.
# SES later: notifications.backends.SesBackend (uses the server's IAM role; then the EMAIL_HOST* lines can go).
EMAIL_BACKEND=
# (optional locally) Required on live with SMTP. Postmark: user and password are both the Server API token.
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_HOST_USER=<postmark-server-token>
EMAIL_HOST_PASSWORD=<postmark-server-token>
# (optional) SMTP port and TLS. Postmark: 587 with TLS.
EMAIL_PORT=587
EMAIL_USE_TLS=true
# (optional) From address for server error emails. Default: DEFAULT_FROM_EMAIL.
SERVER_EMAIL=
# (optional) Postmark bounce and spam-complaint webhook. Both empty = POST /postmark/webhook/ is off (404).
# Long random values, letters and digits only. The same pair goes in the Postmark webhook URL:
# https://USER:PASSWORD@spa99.uk/postmark/webhook/
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
# (optional) Amazon SES region, only with the SES backend.
AWS_SES_REGION_NAME=eu-west-2
# (optional) SNS topic for SES bounces and complaints. Empty = POST /ses/notifications/ is off.
SES_SNS_TOPIC_ARN=

# =====================================================================================================
# AWS / S3 (uploads: Control library, content and plan images, email pictures)
# =====================================================================================================

# (optional) Region of the bucket.
AWS_S3_REGION_NAME=eu-west-2
# (optional) Your Mac only, limited to the dev/ folder. NEVER on the server: it uses its instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =====================================================================================================
# ADDRESSES AND SECURITY
# =====================================================================================================

# (optional) Full URLs for links in emails, no trailing slash. Default https://<domain> (dev http://<domain>:8000).
SITE_URL=
OFFICE_URL=
SYSTEM_URL=
CONTROL_URL=
# (optional) Extra allowed hosts, comma separated (the four domains, localhost and 127.0.0.1 are always allowed).
ALLOWED_HOSTS=
# (optional) Live only: header Caddy fills with the real visitor IP (see the Caddyfile).
CLIENT_IP_HEADER=X-Client-IP
# (optional) Live only: HSTS seconds. Default 3600 (1 hour) at launch; set 31536000 (a year) after a week of clean HTTPS.
SECURE_HSTS_SECONDS=
# (optional) Dev only (scripts/tunnel.sh sets these): trusted origins for a tunnel, and 1 when behind one.
CSRF_TRUSTED_ORIGINS=
DEV_BEHIND_TUNNEL=

# =====================================================================================================
# ERRORS (Sentry)
# =====================================================================================================

# (optional) Off when empty. Sentry > project > Client Keys (DSN).
SENTRY_DSN=
# (optional) Default "live" with the prod settings, "dev" locally.
SENTRY_ENVIRONMENT=
# (optional) Release shown in Sentry. docker-compose sets APP_VERSION from APP_TAG; SENTRY_RELEASE is the fallback.
APP_VERSION=
SENTRY_RELEASE=
# (optional) Share of requests traced / profiled, 0 to 1. Default 0 (off).
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

# =====================================================================================================
# ASK US CHAT (Claude)
# =====================================================================================================

# (optional) Claude API key from the Claude Console. Empty = the chat is off and its button hidden. A secret.
# The monthly spending cap is edited in System > Defaults.
ANTHROPIC_API_KEY=

# =====================================================================================================
# DOCKER (server only: read by docker-compose.yml and entrypoint.sh)
# =====================================================================================================

# (optional locally) Required on the server. Image on Docker Hub and the version to run (the git tag, e.g. 1.2.3).
# Every release: change APP_TAG, then `docker compose pull && docker compose up -d`.
IMAGE=<dockerhub-username>/spa99
APP_TAG=1.0.0
# (optional) Gunicorn processes per container. Default 3.
GUNICORN_WORKERS=3
# (optional) Threads per gunicorn process (gthread). A streamed Ask us reply holds one for a few seconds. Default 8.
GUNICORN_THREADS=8
# (optional) Seconds before gunicorn gives up on a request (big Control uploads need time). Default 300.
GUNICORN_TIMEOUT=300

# =====================================================================================================
# SYSTEM, CONTROL, SITE SWITCHES
# =====================================================================================================

# (optional) Badge System shows. Default DEV locally, LIVE with the prod settings.
SYSTEM_ENV_LABEL=
# (optional) Days to keep the audit log; empty or 0 = forever. Only `manage.py prune_audit_log` uses it.
SYSTEM_AUDIT_RETENTION_DAYS=
# (optional) Largest Control Library upload in MB. Defaults: audio 50, video 500, image 20.
CONTROL_MAX_AUDIO_MB=50
CONTROL_MAX_VIDEO_MB=500
CONTROL_MAX_IMAGE_MB=20
# (optional) Hours a signed link to a Library file stays valid on live. Default 12.
CONTROL_MEDIA_URL_HOURS=12
# (optional) Total size of the Control Library in GB (default 10). Uploads are refused once full.
CONTROL_LIBRARY_MAX_GB=10
# (optional) false turns the 3D Gold Card off everywhere (visitors get the flat card).
SITE_WEBGL=true

# =====================================================================================================
# YOUR MAC ONLY
# =====================================================================================================

# (optional) Settings file. Locally config.settings.dev; live is forced to config.settings.prod by docker-compose.yml.
DJANGO_SETTINGS_MODULE=config.settings.dev
# (optional) Dev only; live always forces it off.
DEBUG=true
# (optional) Private folder with Secrets/.env, db-backups/ and media/. Falls back to .private/ if missing.
SPA99_PRIVATE_DIR=
# (optional) 1 = background jobs run straight away (emails print at once). 0 = test the real queue with `manage.py qcluster`.
Q_SYNC=1
