# HTTPS front door. Cloudflare may sit in front of Caddy (orange cloud); Caddy only believes Cloudflare's own
# connections, and tells the app the real visitor IP in X-Client-IP (the app reads it: CLIENT_IP_HEADER).
{
	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips/). Connections from anywhere else are NOT
		# trusted, so a visitor cannot fake their IP. Re-check the list now and then; it rarely changes.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		# Where the real visitor IP comes from when the connection is from a trusted proxy. Cloudflare overwrites
		# CF-Connecting-IP, unlike the first X-Forwarded-For entry which a visitor can add to.
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(app) {
	reverse_proxy web:8000 {
		# Always overwritten, so a visitor-supplied X-Client-IP never reaches the app.
		header_up X-Client-IP {client_ip}
	}
}

{$DOMAIN} {
	import app
}

{$CONTROL_DOMAIN} {
	# Control Library uploads: video may be up to 500 MB (CONTROL_MAX_VIDEO_MB), so the body limit sits above that.
	request_body {
		max_size 600MB
	}
	import app
}

{$OFFICE_DOMAIN} {
	import app
}

{$SYSTEM_DOMAIN} {
	import app
}

# www goes to the bare domain (needs a www DNS record pointing here too).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
